{
  "name": "appeal-eyeq",
  "version": "0.1.0",
  "private": true,
  "description": "Appeal EyeQ: matter management for property tax appeal attorneys",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "migrate": "node dist/server/migrate.js",
    "start": "node dist/server/migrate.js && node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@tesseract.js-data/eng": "1.0.0",
    "express": "5.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "8.16.3",
    "postal-mime": "2.7.6",
    "qrcode-generator": "2.0.4",
    "tesseract.js": "7.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.4",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
